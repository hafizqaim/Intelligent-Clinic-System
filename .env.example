# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=intelligent_clinic_db
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/intelligent_clinic_db

# ── Auth / JWT ────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# ── Ollama (RAG) ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FORMAT=json          # "json" for production, "console" (default) for dev
# LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
